<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep using the plant's Wi-Fi when it has no internet (LocalNetworks). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- mDNS discovery: phones drop multicast traffic unless an app holds a multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Kiosk mode: recording keeps running in a foreground service with the CPU and Wi-Fi kept awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- After a restart (power outage) kiosk mode and recording start again (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Scanning an observer QR code; tablets without a camera can still paste the link. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Cleartext is needed for local inverter APIs (e.g. Fronius Solar API over plain HTTP). -->
    <application
        android:name=".SolarApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An observer code from the web view's "Open in SolarDash": solardash://observe#<code> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="solardash" android:host="observe" />
            </intent-filter>
        </activity>
        <activity
            android:name=".kiosk.KioskActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity
            android:name=".ui.status.FaultLogActivity"
            android:exported="false" />
        <activity
            android:name=".ui.status.GuideActivity"
            android:exported="false" />
        <!-- Home app (optional, chosen in Android's settings): opens the kiosk after every start. -->
        <activity
            android:name=".kiosk.HomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".kiosk.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".kiosk.KioskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Wall-mounted solar plant display: polls the plant's inverters on the local network once every few seconds and records history while the kiosk display is on." />
        </service>
        <service
            android:name=".work.RecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Solar plant monitoring: reads the plant's inverters, batteries and meters on the local network every few seconds and records their history once a minute while the app runs, also with the screen off (off-grid systems without a display of their own)." />
        </service>
    </application>
</manifest>
