# SolarDash observer web view (/solardash/o/), Apache with mod_headers.
#
# Note: index.html carries the same Content-Security-Policy as a <meta> tag, but a meta CSP can't set
# frame-ancestors (nor X-Frame-Options), so only these headers keep the page out of frames. Keep both policies
# the same when changing one. If the host ignores .htaccess or lacks mod_headers, the meta tag still applies,
# without frame-ancestors.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset utf-8
AddType text/javascript .js
AddType text/css .css

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https:; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # HSTS (remote-viewing.md asks for it). It applies to the whole host amsler-solar.ch, not just this folder, and
    # browsers remember it for max-age: switch it on only when every page of the host is served over HTTPS.
    # Header always set Strict-Transport-Security "max-age=31536000"

    # The page changes with every upload and its SRI hashes must match app.js and style.css: always revalidate.
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Development files, in case they are uploaded by mistake.
<FilesMatch "^(test\.html|test\.js|test-vectors\.json)$">
    Require all denied
</FilesMatch>
